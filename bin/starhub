#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# StarHub Kit CLI Wrapper — Zero-dependency entrypoint
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
exec python3 "${REPO_ROOT}/scripts/starhub-ctl.py" --repo-root "${REPO_ROOT}" "$@"
